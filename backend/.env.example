# AI provider
# Leave blank to use the built-in deterministic demo fallback.
GROQ_API_KEY=

# Authentication
JWT_SECRET=change-this-secret-in-production

# Database (optional; SQLite is used by default)
# DATABASE_URL=sqlite:///./mcapp.db

# Optional Email/SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Optional Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Optional WhatsApp Cloud API
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=janova_campaign
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional OneSignal Push
# ONESIGNAL_APP_ID=
# ONESIGNAL_API_KEY=
